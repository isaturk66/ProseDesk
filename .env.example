# ProseDesk settings. Copy this file to .env (which is git-ignored) and fill it in.

# OpenAI API key for the mic button (speech-to-text).
# Without it, the mic falls back to the browser's built-in speech recognition (Chrome / Edge).
OPENAI_API_KEY=

# Transcription model: gpt-4o-transcribe (best), gpt-4o-mini-transcribe (cheaper), whisper-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional: HTTP proxy for OpenAI requests, if OpenAI isn't available where you are.
OPENAI_PROXY=
